# Database Configuration
# Use PostgreSQL by default. If running Postgres locally or via Docker:
# DATABASE_URL=postgresql://cropshield_user:cropshield_password@localhost:5432/cropshield_db
# For zero-config local development without PostgreSQL/Docker installed:
DATABASE_URL=sqlite:///./cropshield.db

# JWT & Authentication Secret
SECRET_KEY=cropshield_phase1_super_secret_jwt_key_change_in_production_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Plant Information API (Perenual API - Recommended)
# Obtain a free API key at https://perenual.com/docs/api
PERENUAL_API_KEY=
PERENUAL_API_BASE_URL=https://perenual.com/api

# Legacy/Alternative Plant Information API (Trefle)
# Optional fallback if using Trefle: https://trefle.io
PLANT_API_KEY=
PLANT_API_BASE_URL=https://trefle.io/api/v1

# AI Conversational Assistant API: Google Gemini (Primary Chatbot Provider)
# Obtain a free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Weather Advisory API (OpenWeatherMap or compatible service)
# Obtain a free API key from https://openweathermap.org/api
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
